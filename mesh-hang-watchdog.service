[Unit]
Description=Prepper Mesh Hang Watchdog (stuck Telemetrie / Reply)
After=network.target

[Service]
Type=oneshot
User=fmg
WorkingDirectory=/home/fmg/prepper-dashboard
Environment=PYTHONPATH=/home/fmg/prepper-dashboard
# --apply: Restarts ausführen wenn secrets/mesh_hang_autorestart existiert
# Ohne Flag bleibt Detect-only. Flag entfernen = Autorestart aus.
ExecStart=/usr/bin/python3 /home/fmg/prepper-dashboard/mesh_hang_watchdog.py --apply
Nice=10

[Install]
WantedBy=multi-user.target
