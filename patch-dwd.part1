    """Mesh 1: DWD-Warnungen analog NINA (Aenderung / Entwarnung)."""
    global last_dwd_mesh, last_dwd_mesh_status
    try:
        if items is None:
            return False
        if fail_counters.get("dwd_warn", 0) > 0:
            print("DWD: Fetch fehlgeschlagen – Mesh unverändert")
            